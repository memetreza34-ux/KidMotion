{
  "version": 2,
  "name": "KidMotion Flow Prompt Quality — concise v2",
  "goal": "Concrete short single-image prompts; no repeating global style or negative paragraphs per scene.",
  "coverRequiredSections": [
    "CLICK IDEA:",
    "SHOT / COMPOSITION:",
    "CHARACTER:",
    "WORLD:",
    "TEXT:",
    "LIGHT / MATERIALS:",
    "NEGATIVE / STABILITY:",
    "QUALITY CHECK:",
    "OUTPUT:"
  ],
  "sceneRequiredSections": [
    "VIEWER TAKEAWAY:",
    "REFERENCE USE:",
    "SHOT / COMPOSITION:",
    "CHARACTER / POSE:",
    "WORLD / ENVIRONMENT:",
    "TEXT / UI:",
    "LIGHT / MATERIALS:",
    "NEGATIVE / STABILITY:",
    "QUALITY CHECK:",
    "OUTPUT:"
  ],
  "minimumCoverPromptCharacters": 450,
  "minimumScenePromptCharacters": 650,
  "principles": {
    "twoSecondComprehensionTest": true,
    "sceneSpecificCompositionRequired": true,
    "adjacentExerciseCompositionShouldDiffer": true,
    "selectedCoverControlsIdentityAndWorldButMustNotForceComposition": true,
    "fullBodyPoseReadabilityRequired": true,
    "textMustBeExact": true,
    "accidentalTextForbidden": true,
    "timerSafeZoneMustRemainClear": true,
    "aiSlopCheckRequired": true,
    "fillerBeautyShotForbidden": true
  },
  "styleDirection": [
    "clean broadcast-quality educational CGI",
    "clearly stylized and clearly rendered, never photorealistic",
    "controlled matte materials, readable shapes and intentional lighting",
    "strong foreground/midground/background separation",
    "one dominant visual idea with supporting details only when useful"
  ],
  "maximumCoverPromptCharacters": 1200,
  "maximumScenePromptCharacters": 1500,
  "compactPolicy": "v2-short",
  "compactPolicyAppliesWhen": "episode.compactPromptPolicy === 'v2-short'",
  "notes": "Keep all v2 headings, exact labels, the reference and unique shot; phrase each section in 1 sentence. Old episodes remain backward compatible."
}
