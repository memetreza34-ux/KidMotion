{
  "pipelineVersion": 3,
  "projectSchemaVersion": 3,
  "language": "en",
  "aspectRatio": "16:9",
  "fps": 30,
  "resolution": {"width": 1920, "height": 1080},
  "structure": {
    "promptDirectory": "00-bildprompts",
    "finalImageDirectory": "00-bildprompts/images",
    "voiceScriptDirectory": "01-voice-script",
    "audioDirectory": "02-audio",
    "exportDirectory": "03-export",
    "technicalDirectory": "99-technik"
  },
  "publicRuntimeStructure": {
    "root": "public/episodes",
    "layout": "{date}/{episodeFolder}/{images|audio}",
    "dateFormat": "YYYY-MM-DD",
    "example": "public/episodes/2026-10-04/KM-003-full-body-workout/images",
    "legacyFlatAliasesForbidden": true
  },
  "coverPolicy": {
    "coverSceneNumber": 1,
    "coverOutsideVideo": true,
    "coverCandidateCount": 3,
    "candidateFiles": ["Cover-Kandidat-01.png", "Cover-Kandidat-02.png", "Cover-Kandidat-03.png"],
    "mustWaitForExplicitUserSelection": true,
    "selectionFile": "99-technik/COVER_SELECTION.json",
    "finalFile": "Szene 01.png",
    "deleteRejectedCandidatesAfterSelection": true,
    "selectedCoverBecomesPrimaryReference": true
  },
  "imageGenerationPolicy": {
    "sceneFilePattern": "Szene NN.png",
    "firstFinalScene": 1,
    "lastFinalScene": 17,
    "allFinalScenesInOneFolder": true,
    "oneImageOneVisualPurpose": true,
    "finalImagesFlatDirectory": true,
    "automaticAlternateVersionsForbidden": true,
    "regenerationOnlyAfterExplicitRejection": true,
    "renameImmediatelyAfterAcceptance": true,
    "primaryReferenceImage": "Szene 01.png",
    "exerciseUiReferenceImage": "Szene 05.png",
    "blockScenesAfterCoverUntilSelection": true,
    "requireVisualPurpose": true,
    "requireTopicAnchor": true,
    "requireVisualForm": true,
    "requireAcceptanceCriteria": true,
    "googleFlowOwnsAllNonTimerVisibleText": true
  },
  "workoutTiming": {
    "introSeconds": 8,
    "safetySeconds": 4,
    "letsBeginSeconds": 2,
    "exerciseSeconds": 20,
    "restSeconds": 5,
    "exerciseCount": 12,
    "outroSeconds": 4,
    "runtimeSeconds": 313
  },
  "audioPolicy": {
    "voiceFile": "Voice 01.mp3",
    "voiceStartsAtFrameZero": true,
    "voiceMustEndBeforeExerciseOne": true,
    "minimumVoiceSeconds": 13.65,
    "maximumVoiceSeconds": 14.05,
    "backgroundMusicRequired": true,
    "backgroundMusicFile": "bg-music.mp3",
    "backgroundMusicLoop": true,
    "spokenVoiceAfterOpeningForbidden": true
  },
  "renderPolicy": {
    "exerciseImagesStatic": true,
    "restImagesStatic": true,
    "kenBurnsForbiddenOnWorkoutScenes": true,
    "remotionOwnsTimerOnly": true,
    "remotionTextOverlaysForbiddenExceptTimerDigits": true,
    "remotionOwnsProgressBar": false,
    "remotionOwnsRestLabel": false,
    "googleFlowOwnsAllNonTimerVisibleText": true,
    "restReusesNextExerciseImage": true
  },
  "approvalPolicy": {
    "visualReviewRequired": true,
    "coverSelectionRequired": true,
    "sha256AssetLockRequired": true,
    "assetMutationInvalidatesApproval": true
  }
}
