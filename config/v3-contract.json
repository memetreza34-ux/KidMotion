      22,
      24,
      26
    ],
    "exerciseDuration": 20,
    "getReadyDuration": 5,
    "outro": {
      "scene": 28,
      "type": "outro",
      "duration": 4
    },
    "runtimeSeconds": 313,
    "imagePattern": "Szene NN.png"
  },
  "coverContract": {
    "candidateCount": 3,
    "candidateFiles": [
      "Cover-Kandidat-01.png",
      "Cover-Kandidat-02.png",
      "Cover-Kandidat-03.png"
    ],
    "explicitUserChoiceRequired": true,
    "finalFile": "Szene 01.png",
    "deleteRejectedCandidates": true,
    "laterSceneGenerationBeforeChoiceForbidden": true,
    "coverPromptSafety": {
      "clearlyFictionalStylizedCharacterRequired": true,
      "fullyClothedRequired": true,
      "exactMinorAgeForbidden": true,
      "detailedMinorBodyProfileForbidden": true,
      "photorealisticChildForbidden": true,
      "humanSpeciesRequired": true,
      "nonHumanMascotsForbidden": true
    }
  },
  "generationContract": {
    "soleImageReference": "Szene 01.png",
    "secondaryImageReferencesForbidden": true,
    "scene02To28ExactlyOnce": true,
    "maximumAttemptsPerLaterScene": 1,
    "automaticAlternatesForbidden": true,
    "regenerationForbidden": true,
    "serialGenerationRequired": true,
    "parallelGenerationForbidden": true,
    "waitForCurrentResultBeforeNext": true,
    "missingSceneIsHardError": true,
    "copyingPreviousOutputToFillMissingForbidden": true,
    "shiftingLaterFilenamesForbidden": true,
    "internalBatchSize": 5,
    "waitForUserBetweenBatches": false,
    "autoContinueAfterCoverChoice": true,
    "batchControllerCommand": "flow:batch",
    "hardBatchBoundaries": true,
    "batchMustBeCompleteBeforeNext": true,
    "laterBatchOutputBeforeCurrentCompleteForbidden": true,
    "silentVisualQcAfterEachBatch": true,
    "userPromptBetweenBatchesForbidden": true,
    "batchWorkflow": "get allowed 5-scene block -> generate scenes serially -> save all block files -> silent QC of whole block -> immediately request next block"
  },
  "promptContract": {
    "directPromptFile": "00-bildprompts/google-flow-prompt.txt",
    "finalGoogleFlowPromptBlocks": 30,
    "coverPromptBlocks": 3,
    "laterScenePromptBlocks": 27,
    "placeholdersForbiddenBeforeFlow": true,
    "imagePlanMustMatchPrompts": true,
    "allNonTimerVisibleTextOwner": "google-flow",
    "exerciseUi": {
      "titlePosition": "bottom-left",
      "titleStyle": "bold uppercase white sans-serif on dark semi-transparent navy rounded rectangle",
      "instructionPosition": "top-right",
      "instructionStyle": "dark navy text on light cream rounded rectangle",
      "alternatePlaquesForbidden": true
    },
    "getReadyUi": {
      "text": "GET READY + NEXT: <exercise>",
      "position": "right-half outside timer safe zone",
      "style": "dark semi-transparent navy rounded rectangle; white GET READY; bright-cyan NEXT line"
    },
    "timerSafeZoneTopLeftPixels": 230,
    "currentPromptSpecVersion": 2,
    "promptQualityFile": "config/prompt-quality.json",
    "newEpisodesRequirePromptSpecVersion": 2,
    "structuredScenePromptsRequired": true,
    "twoSecondViewerTakeawayRequired": true,
    "sceneSpecificCompositionRequired": true,
    "coverMayGuideIdentityAndWorldButMustNotForceLaterComposition": true
  },
  "voiceContract": {
    "voiceFile": "Voice 01.mp3",
    "oneContinuousFile": true,
    "sections": [
      {
        "scene": "02",
        "label": "INTRO",
        "startSeconds": 0,
        "endSeconds": 8
      },
      {
        "scene": "03",
        "label": "SAFETY",
        "startSeconds": 8,
        "endSeconds": 12
      },
      {
        "scene": "04",
        "label": "LETS_BEGIN",
        "startSeconds": 12,
        "endSeconds": 14
      }
    ],
    "exactTtsCopyRequired": true,
    "targetMinSeconds": 13.65,
    "targetMaxSeconds": 14,
    "absoluteMaxSeconds": 14.05,
    "spokenVoiceAfterSeconds": 14,
    "spokenVoiceAfterOpeningForbidden": true,
    "subtitlesForbidden": true,
    "voiceScriptFormat": "plain-continuous-text-only",
    "voiceScriptMustEqualExactTtsCopy": true,
    "voiceScriptTimecodesForbidden": true,
    "voiceScriptHeadingsForbidden": true,
    "voiceScriptInstructionsForbidden": true,
    "timingMetadataLocation": "99-technik/VOICE_PLAN.json"
  },
  "audioContract": {
    "backgroundMusicFile": "bg-music.mp3",
    "requiredForFinal": true,
    "targetBpm": "120-130",
    "vocalsForbidden": true,
    "commercialYouTubeLicenseRequired": true
  },
  "remotionContract": {
    "visualOverlay": "countdown-timer-only",
    "progressBarForbidden": true,
    "extraTextForbidden": true,
    "workoutKenBurnsForbidden": true,
    "timerSizePixels": 192,
    "timerSafeZonePixels": 230,
    "exerciseCountdown": "20-to-1",
    "getReadyCountdown": "5-to-1",
    "visibleZeroFrameForbidden": true
  },
  "approvalContract": {
    "promptQaBeforeFlow": true,
    "sceneQaAfterImages": true,
    "visualReviewRequired": true,
    "sha256AssetApprovalRequired": true,
    "postrenderSourceMatchRequired": true,
    "postrenderBoundaryTimingCheckRequired": true
  },
  "legacyPolicy": {
    "structureVersionBelow3": "read-only legacy",
    "v3WithoutProductionContractVersion": "read-only pre-contract episode",
    "currentProductionRequiresMatchingContractVersion": true
  },
  "phaseContract": {
    "phase1": {
      "name": "planning",
      "purpose": "Complete scene plan, prompts, voice plan, timing and metadata."
    },
    "phase2": {
      "name": "image-production-and-handoff",
      "purpose": "Create/select final image assets outside Antigravity Phase 3, review them and lock the approved files.",
      "imageCreationAllowed": true,
      "imageCreator": "Google Flow / user-provided image workflow",
      "outputDirectory": "00-bildprompts/images",
      "requiredFinalImages": "Szene 01.png through Szene 28.png",
      "mustRunSceneQa": true,
      "mustCompleteVisualReview": true,
      "mustCreateSha256Approval": true
    },
    "phase3": {
      "name": "antigravity-assembly-only",
      "owner": "Antigravity",
      "antigravityMayGenerateImages": false,
      "antigravityMayRegenerateImages": false,
      "antigravityMayEditImages": false,
      "antigravityMayReplaceImages": false,
      "antigravityMayCreateFallbackImages": false,
      "antigravityMayCallImageGeneration": false,
      "sourceImagesImmutable": true,
      "mayUseOnlyPhase2ApprovedImages": true,
      "requiredInputDirectory": "00-bildprompts/images",
      "requiredInputGate": "phase3:gate",
      "missingOrChangedImageBehavior": "BLOCK_PHASE_3",
      "allowedWork": [
        "discover user-provided Phase 2 handoff files inside the episode",
        "unpack relevant assets from ZIP archives",
        "copy/move deterministic PNG scene files without changing pixels",
        "normalize deterministic scene filenames",
        "reconstruct cover-selection metadata when final Szene 01.png was already chosen in Phase 2",
        "extract/transcode user-provided audio/video containers to required MP3 filenames",
        "write ingest and prepare metadata",
        "run scene QA",
        "visually inspect the actual imported images",
        "create SHA-256 asset approval after visual review",
        "validate approved Phase 2 inputs",
        "activate runtime mappings",
        "assemble existing images",
        "add permitted Remotion timer",
        "use approved voice/music",
        "render video",
        "run postrender QA"
      ],
      "assetIngestAllowed": true,
      "archiveExtractionAllowed": true,
      "deterministicFilenameNormalizationAllowed": true,
      "losslessImageRelocationAllowed": true,
      "audioContainerExtractionAllowed": true,
      "audioTranscodeAllowed": true,
      "imagePixelModificationForbidden": true,
      "visualContentModificationForbidden": true,
      "ingestCommand": "phase3:ingest",
      "ingestBeforeApproval": true,
      "approvalBeforeGate": true,
      "rawHandoffEntryPoint": "phase3:prepare",
      "technicalIngestCommand": "phase3:ingest",
      "coverSelectionReconstructionFromFinalScene01Allowed": true,
      "userManualUnzipRequired": false,
      "userManualAudioConversionRequired": false,
      "agentMustHandleTechnicalNormalizationWhenPossible": true,
      "ambiguousSceneMappingBehavior": "BLOCK_WITH_REPORT",
      "rawHandoffOrder": [
        "phase3:prepare",
        "visual-review-by-agent",
        "assets:approve",
        "kidmotion:activate",
        "phase3:gate",
        "render:safe"
      ],
      "gateMeaning": "phase3:gate validates already reviewed and SHA-256-approved assets; it is never the first command for a raw ZIP/audio handoff"
    }
  },
  "format": "workout",
  "scope": "This contract applies only to contentFormat=workout and the current learn-and-move runtime. It is NOT the channel-wide learning contract.",
  "workoutCharacterPolicyFile": "config/workout-character-policy.json"
}
